    {
      "id": "check_mine_loaded",
      "type": "check",
      "check_id": "check_mine_loaded",
      "label": "验证回到个人中心",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_close_popup", "target": "step_go_settings", "condition": "pass"},
    {"source": "step_go_settings", "target": "check_settings_loaded", "condition": "pass"},
    {"source": "check_settings_loaded", "target": "step_press_back", "condition": "pass"},
    {"source": "step_press_back", "target": "check_mine_loaded", "condition": "pass"}
  ]

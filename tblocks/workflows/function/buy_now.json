{
  "id": "yanxuan/function/buy_now",
  "name": "buy_now",
  "display_name": "网易严选立即购买",
  "description": "验证搜索进入商品详情后点击立即购买可进入订单确认页",
  "category": "business",
  "module": "order",
  "submodule": "buy_now",
  "suites": "smoke",
  "priority": "P0",
  "precondition": "1. 已登录网易严选\n2. 处于首页",
  "steps": "1. 关闭活动弹窗\n2. 搜索商品\n3. 点击第一个商品进入详情页\n4. 点击立即购买",
  "expected": "订单确认页正常加载",
  "author": "workflow_planner",
  "data": "搜索关键词: 毛巾",
  "metadata": {
    "driver": "app_driver",
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {
      "id": "step_close_popup",
      "type": "step",
      "step_id": "close_popup",
      "label": "关闭活动弹窗",
      "params": {}
    },
    {
      "id": "step_search",
      "type": "step",
      "step_id": "step_search",
      "label": "搜索商品",
      "params": {"text": "毛巾"}
    },
    {
      "id": "step_click_first_goods",
      "type": "step",
      "step_id": "click_first_goods",
      "label": "点击第一个商品",
      "params": {}
    },
    {
      "id": "step_buy_now",
      "type": "step",
      "step_id": "step_buy_now",
      "label": "点击立即购买",
      "params": {}
    },
    {
      "id": "check_order_page_loaded",
      "type": "check",
      "check_id": "check_order_page_loaded",
      "label": "检查订单确认页加载",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_close_popup", "target": "step_search", "condition": "pass"},
    {"source": "step_search", "target": "step_click_first_goods", "condition": "pass"},
    {"source": "step_click_first_goods", "target": "step_buy_now", "condition": "pass"},
    {"source": "step_buy_now", "target": "check_order_page_loaded", "condition": "pass"}
  ]
}

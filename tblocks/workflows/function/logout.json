{
  "id": "yanxuan/function/logout",
  "name": "logout",
  "display_name": "网易严选退出登录",
  "description": "验证已登录用户可在设置页退出登录并回到登录页",
  "category": "account",
  "module": "login",
  "submodule": "auth",
  "suites": "smoke",
  "priority": "P0",
  "precondition": "1. 网易严选App已安装\n2. 处于未登录状态\n3. 账号密码正确",
  "steps": "1. 启动App并登录\n2. 进入设置页\n3. 点击退出登录\n4. 确认退出",
  "expected": "退出成功，回到登录页",
  "author": "workflow_planner",
  "metadata": {
    "driver": "first_app_driver",
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {
      "id": "step_click_agree",
      "type": "step",
      "step_id": "click_agreed",
      "label": "同意协议",
      "params": {}
    },
    {
      "id": "step_click_mine",
      "type": "step",
      "step_id": "click_mine",
      "label": "进入个人中心",
      "params": {}
    },
    {
      "id": "step_switch_login_type",
      "type": "step",
      "step_id": "switch_login_type",
      "label": "切换邮箱登录",
      "params": {}
    },
    {
      "id": "step_input_username",
      "type": "step",
      "step_id": "input_username",
      "label": "输入用户名",
      "params": {"username": "${custom_params.username}"}
    },
    {
      "id": "step_input_password",
      "type": "step",
      "step_id": "input_password",
      "label": "输入密码",
      "params": {"password": "${custom_params.password}"}
    },
    {
      "id": "step_click_login",
      "type": "step",
      "step_id": "click_login",
      "label": "点击登录",
      "params": {}
    },
    {
      "id": "check_login_success",
      "type": "check",
      "check_id": "check_login_success",
      "label": "验证登录成功",
      "params": {"expected_text": "用户"}
    },
    {
      "id": "step_close_popup",
      "type": "step",
      "step_id": "close_popup",
      "label": "关闭登录后弹窗并回到首页",
      "params": {}
    },
    {
      "id": "step_go_settings",
      "type": "step",
      "step_id": "step_go_settings",
      "label": "进入设置页",
      "params": {}
    },
    {
      "id": "check_settings_loaded",
      "type": "check",
      "check_id": "check_settings_loaded",
      "label": "检查设置页加载",
      "params": {}
    },
    {
      "id": "step_click_logout",
      "type": "step",
      "step_id": "click_logout",
      "label": "点击退出登录",
      "params": {}
    },
    {
      "id": "step_click_logout_confirm",
      "type": "step",
      "step_id": "click_logout_confirm",
      "label": "确认退出",
      "params": {}
    },
    {
      "id": "check_logout_success",
      "type": "check",
      "check_id": "check_logout_success",
      "label": "验证退出成功",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_click_agree", "target": "step_click_mine", "condition": "pass"},
    {"source": "step_click_mine", "target": "step_switch_login_type", "condition": "pass"},
    {"source": "step_switch_login_type", "target": "step_input_username", "condition": "pass"},
    {"source": "step_input_username", "target": "step_input_password", "condition": "pass"},
    {"source": "step_input_password", "target": "step_click_login", "condition": "pass"},
    {"source": "step_click_login", "target": "check_login_success", "condition": "pass"},
    {"source": "check_login_success", "target": "step_close_popup", "condition": "pass"},
    {"source": "step_close_popup", "target": "step_go_settings", "condition": "pass"},
    {"source": "step_go_settings", "target": "check_settings_loaded", "condition": "pass"},
    {"source": "check_settings_loaded", "target": "step_click_logout", "condition": "pass"},
    {"source": "step_click_logout", "target": "step_click_logout_confirm", "condition": "pass"},
    {"source": "step_click_logout_confirm", "target": "check_logout_success", "condition": "pass"}
  ]
}

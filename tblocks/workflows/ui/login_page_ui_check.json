{
  "id": "yanxuan/ui/login_page_ui_check",
  "name": "login_page_ui_check",
  "display_name": "网易严选登录页界面检查",
  "description": "验证登录页核心界面元素：页面加载、协议勾选框、切换登录方式后账号密码输入框",
  "category": "ui",
  "module": "login",
  "submodule": "ui_check",
  "suites": "ui",
  "priority": "P1",
  "precondition": "1. 网易严选App已安装\n2. 处于未登录状态",
  "steps": "1. 启动App并同意协议\n2. 进入个人中心触发登录页\n3. 验证登录页加载\n4. 验证协议勾选框\n5. 切换密码登录模式\n6. 验证账号密码输入框",
  "expected": "登录页关键元素（切换入口、登录按钮、协议勾选框、账号密码输入框）均正确展示",
  "author": "workflow_planner",
  "metadata": {
    "driver": "first_app_driver",
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {

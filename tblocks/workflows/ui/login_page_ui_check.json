      "type": "step",
      "step_id": "click_agreed",
      "label": "同意协议",
      "params": {}
    },
    {
      "id": "step_click_mine",
      "type": "step",
      "step_id": "click_mine",
      "label": "进入个人中心",
      "params": {}
    },
    {

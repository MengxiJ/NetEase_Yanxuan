  "edges": [
    {"source": "step_close_popup", "target": "check_home_loaded", "condition": "pass"},
    {"source": "check_home_loaded", "target": "step_go_category", "condition": "pass"},
    {"source": "step_go_category", "target": "check_category_loaded", "condition": "pass"},
    {"source": "check_category_loaded", "target": "step_go_cart", "condition": "pass"},
    {"source": "step_go_cart", "target": "check_cart_page_loaded", "condition": "pass"},
    {"source": "check_cart_page_loaded", "target": "step_go_mine", "condition": "pass"},
    {"source": "step_go_mine", "target": "check_mine_loaded", "condition": "pass"},
    {"source": "check_mine_loaded", "target": "check_bottom_tabs_visible", "condition": "pass"}
  ]

{
  "id": "yanxuan/ui/mine_page_check",
  "name": "mine_page_check",
  "display_name": "网易严选个人中心UI检查",
  "description": "验证个人中心页核心UI元素（用户昵称、资产入口、订单入口、设置入口）正常展示",
  "category": "ui",
  "module": "mine",
  "submodule": "ui_check",
  "suites": "ui",
  "priority": "P1",
  "precondition": "1. 已登录网易严选\n2. 处于首页",
  "steps": "1. 关闭活动弹窗\n2. 切换到个人中心\n3. 检查个人中心核心元素",
  "expected": "个人中心所有核心UI元素正常可见",
  "author": "workflow_planner",
  "metadata": {
    "driver": "app_driver",
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {
      "id": "step_close_popup",
      "type": "step",
      "step_id": "close_popup",
      "label": "关闭活动弹窗",
      "params": {}
    },
    {
      "id": "step_go_mine",
      "type": "step",
      "step_id": "step_go_mine",
      "label": "切换到个人中心",
      "params": {}
    },
    {
      "id": "check_mine_loaded",
      "type": "check",
      "check_id": "check_mine_loaded",
      "label": "检查个人中心加载",
      "params": {}
    },
    {
      "id": "check_user_nickname_visible",
      "type": "check",
      "check_id": "check_user_nickname_visible",
      "label": "检查用户昵称",
      "params": {}
    },
    {
      "id": "check_asset_entries_visible",
      "type": "check",
      "check_id": "check_asset_entries_visible",
      "label": "检查资产入口",
      "params": {}
    },
    {
      "id": "check_order_entries_visible",
      "type": "check",
      "check_id": "check_order_entries_visible",
      "label": "检查订单入口",
      "params": {}
    },
    {
      "id": "check_setting_visible",
      "type": "check",
      "check_id": "check_setting_visible",
      "label": "检查设置入口",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_close_popup", "target": "step_go_mine", "condition": "pass"},
    {"source": "step_go_mine", "target": "check_mine_loaded", "condition": "pass"},
    {"source": "check_mine_loaded", "target": "check_user_nickname_visible", "condition": "pass"},
    {"source": "check_user_nickname_visible", "target": "check_asset_entries_visible", "condition": "pass"},
    {"source": "check_asset_entries_visible", "target": "check_order_entries_visible", "condition": "pass"},
    {"source": "check_order_entries_visible", "target": "check_setting_visible", "condition": "pass"}
  ]
}

{
  "id": "yanxuan/ui/settings_check",
  "name": "settings_check",
  "display_name": "网易严选设置页UI界面检查",
  "description": "验证设置页核心UI元素（地址管理、账号与安全、清除缓存、退出登录）正常展示",
  "category": "ui",
  "module": "settings",
  "submodule": "ui_check",
  "suites": "ui",
  "priority": "P1",
  "precondition": "1. 已登录网易严选\n2. 处于首页",
  "steps": "1. 关闭活动弹窗\n2. 进入设置页\n3. 检查设置页各核心元素",
  "expected": "设置页所有核心UI元素正常展示",
  "author": "workflow_planner",
  "metadata": {
    "driver": "app_driver",
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {
      "id": "step_close_popup",
      "type": "step",
      "step_id": "close_popup",
      "label": "关闭活动弹窗",
      "params": {}
    },
    {
      "id": "step_go_settings",
      "type": "step",
      "step_id": "step_go_settings",
      "label": "进入设置页",
      "params": {}
    },
    {
      "id": "check_settings_loaded",
      "type": "check",
      "check_id": "check_settings_loaded",
      "label": "检查设置页加载",
      "params": {}
    },
    {
      "id": "check_address_entry_visible",
      "type": "check",
      "check_id": "check_address_entry_visible",
      "label": "检查地址管理入口",
      "params": {}
    },
    {
      "id": "check_account_entry_visible",
      "type": "check",
      "check_id": "check_account_entry_visible",
      "label": "检查账号与安全入口",
      "params": {}
    },
    {
      "id": "check_clear_cache_visible",
      "type": "check",
      "check_id": "check_clear_cache_visible",
      "label": "检查清除缓存入口",
      "params": {}
    },
    {
      "id": "check_logout_btn_visible",
      "type": "check",
      "check_id": "check_logout_btn_visible",
      "label": "检查退出登录按钮",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_close_popup", "target": "step_go_settings", "condition": "pass"},
    {"source": "step_go_settings", "target": "check_settings_loaded", "condition": "pass"},
    {"source": "check_settings_loaded", "target": "check_address_entry_visible", "condition": "pass"},
    {"source": "check_address_entry_visible", "target": "check_account_entry_visible", "condition": "pass"},
    {"source": "check_account_entry_visible", "target": "check_clear_cache_visible", "condition": "pass"},
    {"source": "check_clear_cache_visible", "target": "check_logout_btn_visible", "condition": "pass"}
  ]
}

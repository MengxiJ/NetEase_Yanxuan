{
  "id": "yanxuan/ui/search_result_ui_check",
  "name": "search_result_ui_check",
  "display_name": "网易严选搜索结果页界面检查",
  "description": "验证搜索结果页商品卡片界面元素：搜索结果命中、商品条目、价格展示",
  "category": "ui",
  "module": "search",
  "submodule": "ui_check",
  "suites": "ui",
  "priority": "P1",
  "precondition": "1. 已登录网易严选\n2. 处于首页",
  "steps": "1. 关闭活动弹窗\n2. 搜索商品\n3. 验证搜索结果命中关键词\n4. 验证商品条目展示\n5. 验证价格展示",
  "expected": "搜索结果页商品卡片（条目与价格）正确展示",
  "author": "workflow_planner",
  "metadata": {
    "setup_hooks": ["step_launch_app"],
    "teardown_hooks": ["step_quit_app"]
  },
  "nodes": [
    {
      "id": "step_close_popup",
      "type": "step",
      "step_id": "close_popup",
      "label": "关闭活动弹窗",
      "params": {}
    },
    {
      "id": "step_search",
      "type": "step",
      "step_id": "step_search",
      "label": "搜索商品",
      "params": {"text": "毛巾"}
    },
    {
      "id": "check_search_result",
      "type": "check",
      "check_id": "check_search_result",
      "label": "验证搜索结果命中",
      "params": {"expected_text": "毛巾"}
    },
    {
      "id": "check_goods_items_displayed",
      "type": "check",
      "check_id": "check_goods_items_displayed",
      "label": "验证商品条目展示",
      "params": {}
    },
    {
      "id": "check_goods_price_displayed",
      "type": "check",
      "check_id": "check_goods_price_displayed",
      "label": "验证价格展示",
      "params": {}
    }
  ],
  "edges": [
    {"source": "step_close_popup", "target": "step_search", "condition": "pass"},
    {"source": "step_search", "target": "check_search_result", "condition": "pass"},
    {"source": "check_search_result", "target": "check_goods_items_displayed", "condition": "pass"},
    {"source": "check_goods_items_displayed", "target": "check_goods_price_displayed", "condition": "pass"}
  ]
}
